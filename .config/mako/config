# ~/.config/mako/config

font=JetBrainsMono Nerd Font Propo 11
width=320
height=110
margin=10
padding=10
border-size=1
border-radius=6
icons=1
max-icon-size=32
markup=1
layer=overlay
anchor=top-right

background-color=#000000ff
text-color=#d8dee9ff
border-color=#00ffffff
progress-color=over #1a1a1aff

default-timeout=5000
ignore-timeout=0

[urgency=low]
border-color=#666666ff
text-color=#888888ff

[urgency=normal]
border-color=#00ffffff
text-color=#d8dee9ff

[urgency=critical]
border-color=#e06c75ff
text-color=#e06c75ff
default-timeout=0
