#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias z='zed . && exit'
alias t='thunar > /dev/null 2>&1 &'
alias vim='nvim'
alias dotfiles='/usr/bin/git --git-dir=/home/grisha/.dotfiles/ --work-tree=/home/grisha'
alias nas='ssh grisha@192.168.1.42'
alias cal='cal -m'
alias mp3='yt-dlp -x --audio-format mp3 --audio-quality 0 -o "%(title)s.%(ext)s"'

web720() {
  ffmpeg -i "$1" -c:v libx264 -crf 27 -preset medium -vf "scale=-2:720" -c:a aac -b:a 128k "${1%.*}_web.mp4"
}

export FZF_DEFAULT_COMMAND='fd --type file'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

PS1='[\u@\h \W]\$ '
export PATH=$HOME/.local/bin:$PATH

# pnpm
export PNPM_HOME="/home/grisha/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end
. "$HOME/.cargo/env"
export TERM="xterm-256color"

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - bash)"
